{
  "name": "countdown-game-electron",
  "version": "1.0.0",
  "description": "Desktop edition of the Countdown Game",
  "main": "main.js",
  "author": "Countdown Game",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.countdowngame.desktop",
    "productName": "Countdown Game",
    "icon": "images/smiley.png",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "index.html",
      "app.js",
      "style.css",
      "images/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
